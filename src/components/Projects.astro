---
import type { ProjectProps } from "@types";
import { Image } from "astro:assets";
import Section from "./Section.astro";

interface Props {
  projects: ProjectProps[];
}

const { projects } = Astro.props;
---

<Section text="Featured Projects" href="projects">
  {
    projects.map(
      ({ name, summary, video, image, linkPreview, linkSource, tech, type }, index) => {
        const top = 98 + index * 40;

        return (
          <div
            style={`top: ${top}px;`}
            class="sticky mb-12 rounded-2xl border border-neutral/20 bg-black"
          >
            <div class="bg-difu relative z-[1] grid h-[580px] w-full grid-rows-2 rounded-2xl bg-[#1c232d]/85 before:absolute before:inset-0 before:z-[-1] before:rounded-2xl before:bg-[url(/raja.png)] before:bg-[length:128px] before:bg-repeat before:opacity-[5%] before:content-[''] sm:grid-cols-2 sm:grid-rows-1 md:h-96 hover:scale-105 transition-transform duration-300">

              <div class="px-6 pt-12">

                <h3 class="mb-2 font-serif text-3xl font-medium text-primary">
                  {name}
                </h3>

                <div class="flex items-center gap-3 pt-4 flex-wrap">

                  {type && (
                    <>
                      <span class="text-xs uppercase tracking-wider text-neutral/70">
                        {type}
                      </span>
                      <span class="h-3 w-px bg-neutral/40"></span>
                    </>
                  )}

                  {tech && (
                    <div class="flex items-center gap-2">
                      {tech.map((t) => (
                        <img
                          src={`/svg/${t.toLowerCase().replace(/\s+/g, "")}.svg`}
                          alt={t}
                          class="h-5 w-auto object-contain transition-transform hover:scale-110"
                          width="30"
                          height="30"
                          loading="lazy"
                        />
                      ))}
                    </div>
                  )}

                </div>

                <p class="text-base text-neutral whitespace-pre-line">
                  {summary}
                </p>

                <div class="flex gap-5 pt-8 text-white">
                  {linkSource && (
                    <a
                      href={linkSource}
                      target="_blank"
                      class="after:relative after:bottom-[-5px] after:content-[url(/source.svg)] hover:underline"
                    >
                      Source
                    </a>
                  )}

                  {linkPreview && (
                    <a
                      href={linkPreview}
                      target="_blank"
                      class="after:relative after:bottom-[-5px] after:content-[url(/external.svg)] hover:underline"
                    >
                      Preview
                    </a>
                  )}
                </div>
              </div>

              <div class="flex items-end justify-end overflow-hidden">
                {
                  video ? (
                    <video
                      class="h-full w-[95%] rounded-ss-xl rounded-ee-2xl object-cover sm:h-[85%] sm:w-full"
                      autoplay
                      muted
                      loop
                      playsinline
                    >
                      <source src={video} type="video/webm" />
                    </video>
                  ) : (
                    <Image
                      class="h-full w-[95%] rounded-ss-xl rounded-ee-2xl object-none object-left-top sm:h-[85%] sm:w-full"
                      src={image}
                      alt={name}
                      width="736"
                      height="483"
                    />
                  )
                }
              </div>
            </div>
          </div>
        );
      }
    )
  }
</Section>